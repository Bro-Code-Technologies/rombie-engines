+++ b/common/core/source/controller-manager.c
@@ -12,6 +12,20 @@ void ControllerManager_Initialise(ControllerManager* const manager)
 		ControllerMultitapSega_Initialise(&manager->state.sega_multitaps[i]);
 }
 
+typedef struct ControllerManager_SegaTapPads
+{
+	Controller_Callback callback;
+	const void *user_data;
+	cc_u8f first_pad;
+} ControllerManager_SegaTapPads;
+
+static cc_bool ControllerManager_SegaTapCallback(void* const user_data, const cc_u8f controller_index, const Controller_Button button)
+{
+	const ControllerManager_SegaTapPads* const pads = (const ControllerManager_SegaTapPads*)user_data;
+
+	return pads->callback((void*)pads->user_data, pads->first_pad + controller_index, button);
+}
+
 cc_u8f ControllerManager_Read(ControllerManager* const manager, const cc_u8f port_index, const cc_u16f microseconds, const Controller_Callback callback, const void* const user_data)
 {
 	assert(port_index < 2);
@@ -25,7 +39,15 @@ cc_u8f ControllerManager_Read(ControllerManager* const manager, const cc_u8f por
 			return ControllerMultitapEA_ReadPort(&manager->state.ea_multitap, port_index, microseconds, callback, user_data);
 
 		case CONTROLLER_MANAGER_PROTOCOL_SEGA_TAP:
-			return ControllerMultitapSega_Read(&manager->state.sega_multitaps[port_index], callback, user_data);
+		{
+			/* Each Team Player's own pads are numbered 0 to 3, so the second port's are pads 4 to 7: players 5 to 8. */
+			ControllerManager_SegaTapPads pads;
