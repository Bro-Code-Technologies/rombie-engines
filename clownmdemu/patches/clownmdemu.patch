+			pads.callback = callback;
+			pads.user_data = user_data;
+			pads.first_pad = port_index * 4;
+			return ControllerMultitapSega_Read(&manager->state.sega_multitaps[port_index], ControllerManager_SegaTapCallback, &pads);
