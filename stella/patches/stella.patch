+// A stick's X axis, with the deadzone option applied
+static int32_t analog_x(int pad)
+{
+  int32_t x = input_state_cb(pad, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_LEFT, RETRO_DEVICE_ID_ANALOG_X);
+  if(stella_paddle_analog_deadzone && std::abs(x) < stella_paddle_analog_deadzone * 0x7fff / 100)
+    x = 0;
+  return x;
+}
+
+// Relative mode (the default): the stick turns the dial at a speed set by how far it is pushed, and the
+// dial stays where it is when the stick is let go. Absolute mode: the stick's position is the dial's.
+static int32_t paddle_axis(int pad, int32_t& position)
+{
+  const int32_t x = analog_x(pad);
+  if(stella_paddle_analog_absolute)
+    position = x;
+  else
+    position = BSPF::clamp(position + x / 50, -0x7fff, 0x7fff);
+  return position;
+}
