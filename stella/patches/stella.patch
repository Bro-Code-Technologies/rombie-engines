+    std::fill_n(header, 256, uInt8{0xff});
+    header[0] = 0xac;  header[1] = 0xfa;
+    header[2] = 0x0f;
+    header[3] = 24;
+    header[4] = 0;
+    header[5] = 0;
+    header[6] = 0x24;  header[7] = 0x02;
+    header[4] = static_cast<uInt8>(0x55 - checksum(header, 8));
+    for(uInt8 j = 0; j < 24; ++j)
+    {
+      header[16 + j] = static_cast<uInt8>(((j % 8) << 2) | (j / 8));
+      header[64 + j] = 0;
+    }
+    header[255] = 0;
+  }
 
