diff --git a/core/libretro.c b/core/libretro.c
index c6fd112..1f67341 100644
--- a/core/libretro.c
+++ b/core/libretro.c
@@ -446,7 +446,13 @@ bool retro_serialize(void *data, size_t size)
    if ((fast_savestates && size != FAST_SAVE_STATE_SIZE) || (!fast_savestates && size != SAVE_STATE_SIZE))
       return false;
 
-   return prosystem_Save((char*)data, fast_savestates);
+   /* Rombie: zero-filled, so the bytes the state leaves unused are the same in every engine, and what the state
