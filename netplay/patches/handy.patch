 static unsigned retro_overclock = 1;
 
+/* Changed for Rombie (2026-11-18): the ComLynx link. With handy_link_consoles above 1 the core runs that many Lynxes on
+ * one cable, console n reading input port n. Each PC shows one of them (handy_link_screen) and hears one
+ * (handy_link_audio), and every PC runs all of them alike. Console 1 is lynx; with one console the core is as it was.
+ * Handy keeps a Lynx in globals (system.h), so each console has its own copy, put in place while it runs. */
+#define LINK_MAX_CONSOLES 8
+#define LINK_STATE_MAGIC  "HLNK"
+
+struct link_console
+{
+   CSystem *sys;
+   HandyGlobals globals;
+   uint8_t *framebuffer;
+   UBYTE audio[HANDY_AUDIO_BUFFER_SIZE];
+   ULONG audio_length;
+};
+
+static link_console link_consoles[LINK_MAX_CONSOLES];
+static unsigned link_count  = 1;
+static unsigned link_screen = 0;
+static unsigned link_audio  = 0;
+/* The system cycles each console runs before the next takes its turn (handy_link_slice). */
+static ULONG link_slice     = 1024;
+/* Console n is switched on n * (link_stagger frames and 1/link_count of a frame) after console 1 (handy_link_stagger,
+ * read as the game loads), as players switch theirs on a moment apart. Started on the same cycle, the consoles run
+ * alike to the cycle and make the same choices from what they hear, and the link never forms. Real Lynxes run on their
+ * own crystals, so their frames fall anywhere against each other's; here they share one clock, and the part of a frame
+ * keeps their vertical blanks, where RedEye sends each player's state in play, apart. link_frame counts the frames
+ * since power-on and is in the state. */
+static unsigned link_stagger = 20;
+static uint32_t link_frame   = 0;
+
+static uint64_t link_power_on(unsigned n)
+{
+   return (uint64_t)n * ((uint64_t)link_stagger * retro_cycles_per_frame + retro_cycles_per_frame / link_count);
+}
+
+/* The ComLynx wire: one line every console drives and hears, its idle level high and any console's low bit winning
+ * (wired-AND). Each frame a console sends is kept with the bus cycles it starts and ends at (end 0 while it is still
+ * going out; bus cycles count from power-on, on the frame clock all consoles share). After each round of turns, every
+ * frame that has ended goes to every console that is on, the sender too, merged with every frame that overlapped it:
+ * two consoles sending at once both get the AND of their bytes back, so each sees its echo differ from what it sent,
+ * and when the frames did not start together, a framing error, as on the real cable. Its frames are in the state. */
+#define LINK_WIRE_MAX     32
+#define LINK_WIRE_END     (-1)
+#define LINK_WIRE_FRAMING 0x10000
+
+struct link_wire_frame
+{
+   uint32_t sender;
+   uint32_t data;
+   uint64_t start;
+   uint64_t end;
+   uint32_t delivered;
+};
+
+static link_wire_frame link_wire[LINK_WIRE_MAX];
+static uint32_t link_wire_count = 0;
+
+static uint64_t link_bus_cycle(void)
+{
+   return (uint64_t)link_frame * retro_cycles_per_frame + (ULONG)(gSystemCycleCount - gLastRunCycleCount);
+}
+
+static void link_wire_end(ULONG sender, uint64_t now)
+{
+   for (uint32_t i = 0; i < link_wire_count; i++)
+      if (link_wire[i].sender == sender && !link_wire[i].end)
+         link_wire[i].end = now > link_wire[i].start ? now : link_wire[i].start + 1;
+}
+
+static void link_enter(unsigned n)
+{
+   if (link_count > 1)
+      HandyGlobalsLoad(&link_consoles[n].globals);
+}
+
+static void link_leave(unsigned n)
+{
+   if (link_count > 1)
+      HandyGlobalsSave(&link_consoles[n].globals);
+}
+
+/* A console starts a frame on the wire (its nine bits, or UART_BREAK_CODE), or ends the one it is sending. */
+static void link_tx(int data, ULONG objref)
+{
+   uint64_t now = link_bus_cycle();
+
+   link_wire_end(objref, now);
+   if (data == LINK_WIRE_END)
+      return;
+   if (link_wire_count == LINK_WIRE_MAX)
+   {
+      memmove(link_wire, link_wire + 1, (LINK_WIRE_MAX - 1) * sizeof(link_wire[0]));
+      link_wire_count--;
+   }
+   link_wire[link_wire_count].sender    = objref;
+   link_wire[link_wire_count].data      = (uint32_t)data;
+   link_wire[link_wire_count].start     = now;
+   link_wire[link_wire_count].end       = 0;
+   link_wire[link_wire_count].delivered = 0;
+   link_wire_count++;
+}
+
+/* Every ended frame, earliest first, to every console that is on by the end of the round (bus cycle now); then the
+ * frames nothing still to come can overlap are let go. */
+static void link_wire_settle(uint64_t now)
+{
+   uint64_t open_start = UINT64_MAX;
+   uint32_t kept       = 0;
+
+   for (;;)
+   {
+      int x = -1;
+      uint32_t value;
+      uint32_t framing = 0;
+
+      for (uint32_t i = 0; i < link_wire_count; i++)
+         if (link_wire[i].end && !link_wire[i].delivered &&
+               (x < 0 || link_wire[i].end < link_wire[x].end ||
+                (link_wire[i].end == link_wire[x].end && link_wire[i].sender < link_wire[x].sender)))
+            x = (int)i;
+      if (x < 0)
+         break;
+      value = link_wire[x].data;
+      for (uint32_t j = 0; j < link_wire_count; j++)
+      {
+         if ((int)j == x || link_wire[j].start >= link_wire[x].end ||
+               (link_wire[j].end && link_wire[j].end <= link_wire[x].start))
+            continue;
+         if (value == UART_BREAK_CODE || link_wire[j].data == UART_BREAK_CODE)
+            value = UART_BREAK_CODE;
+         else
+            value &= link_wire[j].data;
+         if (link_wire[j].start != link_wire[x].start)
+            framing = LINK_WIRE_FRAMING;
+      }
+      link_wire[x].delivered = 1;
+      for (unsigned k = 0; k < link_count; k++)
+      {
+         if (link_power_on(k) >= now)
+            continue;
+         link_enter(k);
+         link_consoles[k].sys->ComLynxLinkRx((int)(value | framing));
+         gNextTimerEvent = gSystemCycleCount;
+         link_leave(k);
+      }
+   }
+
+   for (uint32_t i = 0; i < link_wire_count; i++)
+      if (!link_wire[i].end && link_wire[i].start < open_start)
+         open_start = link_wire[i].start;
+   for (uint32_t i = 0; i < link_wire_count; i++)
+      if (!(link_wire[i].delivered && link_wire[i].end <= open_start))
+         link_wire[kept++] = link_wire[i];
+   link_wire_count = kept;
+}
+
+/* The consoles that are on take turns, link_slice system cycles each, until every one has run the frame's cycles, and
+ * the wire delivers what has ended after each round. A console switched on during the frame runs from there. */
+static void link_run_frame(void)
+{
+   unsigned n;
+   ULONG done           = 0;
+   uint64_t frame_start = (uint64_t)link_frame * retro_cycles_per_frame;
+
+   for (n = 0; n < link_count; n++)
+   {
+      uint64_t on = link_power_on(n);
+      link_enter(n);
+      gLastRunCycleCount = gSystemCycleCount;
+      if (on > frame_start && on < frame_start + retro_cycles_per_frame)
+         gLastRunCycleCount -= (ULONG)(on - frame_start);
+      link_leave(n);
+   }
+
+   while (done < retro_cycles_per_frame)
+   {
+      done = (retro_cycles_per_frame - done > link_slice) ? done + link_slice : retro_cycles_per_frame;
+      for (n = 0; n < link_count; n++)
+      {
+         CSystem *sys = link_consoles[n].sys;
+         if (link_power_on(n) >= frame_start + done)
+            continue;
+         link_enter(n);
+         while (gSystemCycleCount - gLastRunCycleCount < done)
+         {
+            sys->Update();
+            for (int lcv = 1; lcv < retro_overclock; lcv++)
+               sys->Overclock();
+         }
+         link_leave(n);
+      }
+      link_wire_settle(frame_start + done);
+   }
+   link_frame++;
+}
+
+static void link_delete_all(void)
+{
+   for (unsigned n = 0; n < LINK_MAX_CONSOLES; n++)
+   {
+      if (link_consoles[n].sys)
+      {
+         link_consoles[n].sys->SaveEEPROM();
+         delete link_consoles[n].sys;
+         link_consoles[n].sys = NULL;
+      }
+   }
+   lynx = 0;
+}
