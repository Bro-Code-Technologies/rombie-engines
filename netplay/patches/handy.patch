+
+static int ParityOdd(int data)
+{
+   data&=0xff;
+   data^=data>>4;
+   data^=data>>2;
+   data^=data>>1;
+   return data&1;
+}
+
+// Changed for Rombie (2026-11-18): the ninth bit sent, as Mikey sends it: the parity bit, or PAREVEN with parity off.
+static int NinthBit(int data,ULONG parity_enable,ULONG parity_even)
+{
+   if(parity_enable) return parity_even ? ParityOdd(data) : !ParityOdd(data);
+   return parity_even ? 1 : 0;
