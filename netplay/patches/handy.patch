+// Changed for Rombie (2026-11-18): a frame off the wire, into the one receive register: a byte still unread is
+// overrun, a collision of frames that started apart (0x10000) a framing error, and with parity on a wrong ninth bit a
+// parity error (all until RESETERR).
+void CMikie::ComLynxLinkRx(int data)
+{
+   if(data&0x10000) mUART_Rx_framing_error=1;
+   data&=0xffff;
+   if(mUART_RX_READY) mUART_Rx_overun_error=1;
