+
+// The memory cards' "new card" flags, which the game reads, are outside sioFreeze's format; misc.c saves them, marked
+// so a state saved without them leaves them as they are.
+#define NEW_CARD_FLAGS_MARK 0x4d430000
+
+u32 sioNewCardFlags(void) {
+	return NEW_CARD_FLAGS_MARK | (cardh1[1] << 8) | cardh2[1];
+}
+
+void sioSetNewCardFlags(u32 flags) {
+	if ((flags & 0xffff0000) != NEW_CARD_FLAGS_MARK)
+		return;
+	cardh1[1] = flags >> 8;
+	cardh2[1] = flags;
+}
